# Docker
COMPOSE_PROFILES=dev

# Database
POSTGRES_USER=nomnom
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nomnom
POSTGRES_HOST=db

# App
SECRET_KEY=change_me
ANTHROPIC_API_KEY=

# CORStha
CORS_ORIGINS=http://localhost:5174,https://fit.spryszynski.pl

# Nutrition APIs (optional)
USDA_API_KEY=

# GitHub OAuth (optional — enables "Sign in with GitHub" button)
# Register at: https://github.com/settings/applications/new
#   Homepage URL:        https://fit.spryszynski.pl
#   Authorization callback URL: https://fit.spryszynski.pl/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://fit.spryszynski.pl/auth/github/callback

# Frontend — the button only appears when this is set (same value as GITHUB_CLIENT_ID)
# The frontend Docker service already reads .env via env_file, so just add it here:
VITE_GITHUB_CLIENT_ID=
